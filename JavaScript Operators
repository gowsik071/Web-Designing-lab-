<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <script>
        // Operators

        // Arithmatic Operators

        a=10
        b=56
        document.write(a+b,"<br>");
        document.write(a-b,"<br>");
        document.write(a*b,"<br>");
        document.write(a/b,"<br>");
        document.write(a%b,"<br>");
        document.write(2**3,"<br>");

        // Uniary operator

        a=10
        b=20

        // Pre decrement (Sub,Print)

        document.write(--a,"<br>");

        // Post decrement (Print,Sub)

        document.write(a--,"<br>");
        document.write(a,"<br>");

        // Pre increment (add,print)

        document.writeln(++b,"<br>");
        

        document.writeln(b++,"<br>")
        document.write(b,"<br>")

        // Comparison Operator

        a=20
        b=40

        document.writeln(a<b,"<br>");
        document.writeln(a>b,"<br>");
        document.writeln(a==b,"<br>");
        document.writeln(a!=b,"<br>");
        document.writeln(a<=b,"<br>");
        document.writeln(a>=b,"<br>");

        
        a=28
        b=67

        document.writeln(a!=b & a>b,"<br>");
        document.writeln(a==b & a>b,"<br>");
        document.writeln(a==b | a>b,"<br>");
        document.writeln(!(a==b & a>b,"<br>"));

        // Logical Operators

        var a=25;
        a+=4;
        a-=6;
        a*=2;
        a/=2;
        a**=3;
        a%=4;

        document.write(a);

        // Ternary Operator

        a=89
        b=34

        var d=(a>b)? "yes": "no";
        document.write(d,"<br>");

        var t=(a>b)? 1:0;
        document.write(d,"<br>");

        var k=(a>b)? true : false;
        document.write(k,"<br>")

        var r=(a<b)? true : false;
        document.write(r)




    </script>
</body>
</html>
