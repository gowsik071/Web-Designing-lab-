<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <script>

        // For loop Increment

        for (i=1; i<=10; i++){
            document.write(i,"<br>");

        }

        for (i=2; i<=15; i++){
            document.write(i,"<br>")
        }

        a=['a','b','r',2,3,4,5,6,7]
        document.write(a[0],"<br>");
        document.write(a[1],"<br>");
        document.write(a[2],"<br>");
        document.write(a[5],"<br>")
        document.write(a.length,"<br>")
        

        for (i=0; i<a.length; i++){
            document.write(a[i],"<br>")
        }

        // For loop- Decrement

        for (i=10; i>=1; i--){
            document.write(i,"<br>");
        }

        // While lopp- Increment

        a=1;
        while(a<11){
            document.write(a,"<br>");
            a++;
        }

        // While loop- Decrement

        a=10;
        while(a>0){
            document.write(a,"<br>");
            a--;
        }

        // Do While

        a=10;
        do{
            document.write(a,"<br>");
            a--;

        }while(a>5)

        // Jumping Statement

        for (i=1; i<=10; i++){
            if (i==5){
                break;
            }
            document.write(i,"<br>");
        }

        for (i=1; i<=10; i++){
            if (i==6){
                continue;
            }
            document.write(i,"<br>")
        }

        // Array

        a=[];
        a[0]=10;
        a[1]=27;
        a[2]=30;
        a[3]=40;
        a[4]=57;
        document.write(a,"<br>")
        document.write(a.length,"<br>")

        // Object Array

        a=new Array(1,2,3,4,5);
        document.write(a,"<br>");

        // For loop Array

        a=[1,23,45,65,78];
        for (i of a){
            document.write(i,"<br>");
        }

      
    </script>
    
</body>
</html>
